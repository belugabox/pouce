# Copier en `.env` pour le développement local.
PORT=3001
LOG_LEVEL=debug
# Base SQLite (catalogue des partitions) et paquet PDMX.
DATA_PATH=./data
# Paquet PDMX ailleurs que dans DATA_PATH :
# CATALOG_PACK=./data/pdmx.jsonl.gz
# Derrière un proxy : adresse du client lue dans X-Forwarded-For.
# TRUST_PROXY=true
